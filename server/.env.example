# Banco PostgreSQL. Com EMBEDDED_DB=true o próprio projeto liga um PostgreSQL local
# (dados em server/.pgdata). Use false para apontar para um PostgreSQL já instalado.
DATABASE_URL="postgresql://routine:routine@localhost:5433/routine_tracker"
EMBEDDED_DB=true

# Texto longo e aleatório usado para assinar o login
JWT_SECRET="troque-por-um-texto-longo-e-aleatorio"

PORT=3000

# Endereço usado nos links de convite. Vazio = IP da máquina na rede.
PUBLIC_URL=
